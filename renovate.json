{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "addLabels": [
        "auto-merge"
      ],
      "automerge": true,
      "automergeType": "pr",
      "description": "Auto merge all minor and patch updates to renovate itself. Renovate merges the PR itself once its checks pass: the workflows run on pull requests only, so a branch without a PR gets no checks.",
      "groupName": "renovate",
      "matchPackageNames": "renovatebot/github-action",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "platformAutomerge": false,
      "schedule": [
        "before 5am on Monday"
      ]
    },
    {
      "automerge": false,
      "commitMessagePrefix": "[MAJOR] ",
      "description": "Create PRs for major changes to renovate itself.",
      "groupName": "renovate MAJOR",
      "matchPackageNames": "renovatebot/github-action",
      "matchUpdateTypes": [
        "major"
      ],
      "schedule": [
        "before 5am on Monday"
      ]
    },
    {
      "addLabels": [
        "auto-merge"
      ],
      "automerge": true,
      "automergeType": "pr",
      "description": "Auto merge all minor and patch updates to github-actions. Renovate merges the PR itself once its checks pass: the workflows run on pull requests only, so a branch without a PR gets no checks.",
      "groupName": "github-actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "platformAutomerge": false
    },
    {
      "automerge": false,
      "commitMessagePrefix": "[MAJOR] ",
      "description": "Create PRs for major changes to github-actions.",
      "groupName": "github-actions MAJOR",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "addLabels": [
        "auto-merge"
      ],
      "automerge": true,
      "automergeType": "pr",
      "description": "Auto merge all minor and patch updates to pre-commit actions. Renovate merges the PR itself once its checks pass: the workflows run on pull requests only, so a branch without a PR gets no checks.",
      "groupName": "pre-commit",
      "matchDatasources": [
        "github-releases"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "platformAutomerge": false,
      "schedule": [
        "before 5am on Tuesday"
      ]
    },
    {
      "automerge": false,
      "commitMessagePrefix": "[MAJOR] ",
      "description": "Create PRs for major changes to pre-commit actions.",
      "groupName": "pre-commit MAJOR",
      "matchDatasources": [
        "github-releases"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "schedule": [
        "before 5am on Tuesday"
      ]
    }
  ],
  "reviewers": [
    "TheRealArthurDent"
  ]
}
