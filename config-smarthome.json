{
  "assignees": [
    "TheRealArthurDent"
  ],
  "branchPrefix": "renovate/",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update rev variables in pre-commit-config",
      "managerFilePatterns": [
        "/(^|/)\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s+rev:\\s+[\"']?(?<currentValue>[\\w+\\.\\-]*)[\"']?"
      ]
    }
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "forkProcessing": "disabled",
  "gitIgnoredAuthors": [
    "118576523+P4ranoidAndroid@users.noreply.github.com"
  ],
  "ignorePrAuthor": true,
  "onboarding": true,
  "packageRules": [
    {
      "automerge": false,
      "description": "Always create PRs for major changes.",
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "addLabels": [
        "patch"
      ],
      "matchUpdateTypes": [
        "patch"
      ]
    },
    {
      "addLabels": [
        "minor"
      ],
      "matchUpdateTypes": [
        "minor"
      ]
    },
    {
      "addLabels": [
        "major"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "addLabels": [
        "docker"
      ],
      "matchCategories": [
        "docker"
      ]
    },
    {
      "addLabels": [
        "python"
      ],
      "matchCategories": [
        "python"
      ]
    }
  ],
  "platform": "github",
  "rebaseWhen": "behind-base-branch",
  "repositories": [
    "TheRealArthurDent/homelab-engineering",
    "TheRealArthurDent/infrastructure",
    "TheRealArthurDent/smart-home",
    "TheRealArthurDent/private-cloud",
    "TheRealArthurDent/ikea-firmware-downloader"
  ],
  "reviewers": [
    "TheRealArthurDent"
  ]
}
